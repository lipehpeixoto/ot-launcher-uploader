# Can be relative or absolute path
CLIENT_PATH=otclient
# Staging dir for the canary runtime tree. stage-canary-release.js wipes
# and repopulates this from CANARY_SOURCE using the bundle-canary.js
# allowlist; sync.js then hashes it and uploads under the server/ prefix.
CANARY_PATH=canary
# Canary working tree (the repo). stage-canary copies a curated subset of
# this into CANARY_PATH. Typically points at the ot-canary repo root.
CANARY_SOURCE=../ot-canary
UPLOAD_CONCURRENCY=5
R2_CDN_URL=cdn-url
R2_BUCKET=bucket-name
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-key
R2_REGION=auto
S3_ENDPOINT=r2-cf-endpoint